<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Weblio" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/weblio_gray_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Weblio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/weblio_gray_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Weblio</item>
    </style>
</resources>
